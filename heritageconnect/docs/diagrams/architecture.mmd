flowchart LR
    U["Browser<br/>(desktop / tablet / mobile)<br/>Leaflet + Bootstrap 5"]
    OSM["OpenStreetMap<br/>tile servers"]
    NOM["Nominatim<br/>(address search)"]

    subgraph HOST["Your computer (Docker)"]
        direction LR
        subgraph NET["heritage_net — bridge network 172.28.0.0/24"]
            direction LR
