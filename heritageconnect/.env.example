# HeritageConnect environment variables
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# Never commit the real .env file.

# --- PostGIS database ---
POSTGRES_DB=heritageconnect
POSTGRES_USER=heritage_user
POSTGRES_PASSWORD=change-me

# Django connects to the database through the Docker service name.
DATABASE_HOST=db
DATABASE_PORT=5432

# --- PgAdmin4 (http://localhost:5050) ---
PGADMIN_DEFAULT_EMAIL=admin@example.com
PGADMIN_DEFAULT_PASSWORD=change-me

# --- Django ---
# Generate a key with:
#   python -c "from django.core.management.utils import get_random_secret_key as k; print(k())"
DJANGO_SECRET_KEY=replace-with-a-long-random-secret-key
# False = production-style (safe default, use for assessment/demo).
# Set to True only while developing (detailed errors + auto-reload).
DJANGO_DEBUG=False

# Only set to True when the site is served over HTTPS: enables secure
# cookies, HSTS and HTTP->HTTPS redirect. Keep False for local HTTP.
DJANGO_SECURE_COOKIES=False

# Hosts/origins Django accepts (comma-separated)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://localhost:8000,http://127.0.0.1:8000

# Password for the demo account (python manage.py create_demo_user)
DEMO_USER_PASSWORD=HeritageDemo2026!
